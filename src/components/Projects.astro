---
import PROJECTS from '@/data/projects.json';
import Parallax from '@/components/Parallax.astro';
---

<section id="projects" class="w-full px-4 mt-30 relative isolate">
  <Parallax />
  <div class="max-w-4xl mx-auto">
  <div class="mb-5 relative z-10">
      <h2 class="flex items-center gap-2 font-pixel font-bold text-3xl">
        <svg class="size-7" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M15 12h.01"></path><path d="M12 12h.01"></path><path d="M9 12h.01"></path><path d="M6 19a2 2 0 0 1 -2 -2v-4l-1 -1l1 -1v-4a2 2 0 0 1 2 -2"></path><path d="M18 19a2 2 0 0 0 2 -2v-4l1 -1l-1 -1v-4a2 2 0 0 0 -2 -2"></path></svg>
        Proyectos
      </h2>
      <div class="mt-2 h-0.5 w-20 bg-linear-to-r from-accent/70 to-transparent"></div>
  </div>

  <div class="flex flex-col gap-y-16 relative z-10">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-6 md:flex-row md:space-x-10 lg:space-y-0">
  <div class="w-full lg:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 shadow-xl overflow-clip rounded-xl sm:rounded-xl lg:border lg:border-gray-500/30">
      <img alt={title} class="object-cover object-top w-full h-56 sm:h-full" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
    <h3 class="text-2xl font-bold text-accent">
      {title}
    </h3>
    <ul class="flex flex-row flex-wrap mt-3 gap-2">
    </ul>

    <p class="mt-3 text-text-soft text-pretty">{description}</p>
    <footer class="flex items-center mt-4 gap-x-4">
      
      
    </footer>
  </div>
</article>
    ))
  }
</div>
</div>

</section>

