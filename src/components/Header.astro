---
import { Moon, Sun } from '@lucide/astro';
---

<header class="grid grid-cols-3 items-center w-full max-w-4xl px-4 py-5">
    <a href="/" class="flex items-center gap-x-3 justify-self-start">
        <img src="https://avatars.githubusercontent.com/u/183173739?v=4" alt="Andres photo" class="w-10 h-10 rounded-full" />
    </a>

    <nav class="flex items-center gap-x-12 text-sm font-medium justify-self-center">
        <a href="/#experience" class="transition-colors hover:text-[--accent]">Experience</a>
        <a href="/#projects" class="transition-colors hover:text-[--accent]">Projects</a>
        <a href="/#about" class="transition-colors hover:text-[--accent]">About</a>
        <a href="/#contact" class="transition-colors hover:text-[--accent]">Contact</a>
    </nav>

    <button 
        id="theme-toggle" 
        type="button" 
        aria-label="Change color theme"
        class="justify-self-end relative w-9 h-9 flex items-center justify-center rounded-lg active:scale-90 cursor-pointer"
    >
        <Moon class="moon-icon absolute" size={20} stroke-width={1.5} />
        <Sun class="sun-icon absolute" size={20} stroke-width={1.5} />
    </button>
</header>

<script>
    const themeToggle = document.getElementById('theme-toggle');

    themeToggle?.addEventListener('click', () => {
        const isLight = document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
</script>