---
---

<main>

<!-- Text Section -->
<section class="w-full flex flex-col items-center justify-center text-center gap-y-6 px-4 pt-12 pb-8">
    <p id="eyebrow" class="flex items-center gap-x-3 text-sm">
        <span class="status-dot"></span>
        <span class="text-text-soft">Disponible para nuevos proyectos.</span>
    </p>
    <h1 class="w-full flex flex-col gap-y-5 font-pixel font-bold text-6xl">
        <span id="hero-title-role" class="animated-gradient block w-full h-15">Full Stack Developer</span>
        <span id="hero-title-name" class="block w-full h-15">Andrés Retamoso</span>
    </h1>
    <p id="hero-description" class="text-text-soft font-medium text-md block w-full h-7">📍 Barranquilla, Colombia.</p>
</section>

<!-- Icons Section -->
<section class="flex items-center justify-center">
  <ul class="flex items-center gap-x-4 animate-fade-in-delayed">
    <a 
      href="https://github.com/saruuuu19" 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label="GitHub Profile"
      class="transition-all duration-00 ease-out hover:scale-115 hover:-translate-y-1 active:scale-95 opacity-85 hover:opacity-100"
    >
      <svg width="32" height="32" fill="none" viewBox="0 0 1024 1024"><path fill="currentColor" fill-rule="evenodd" d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0" clip-rule="evenodd"/></svg>
    </a>
    <a 
      href="https://www.linkedin.com/in/andres-retamoso-08266b3a2/" 
      target="_blank" 
      rel="noopener noreferrer" 
      aria-label="LinkedIn Profile"
      class="transition-all duration-300 ease-out hover:scale-115 hover:-translate-y-1 active:scale-95 opacity-85 hover:opacity-100"
    >
      <svg width="32" height="32" viewBox="0 0 256 256"><path fill="#0a66c2" d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.91 39.91 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186zM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009s9.851-22.014 22.008-22.016c12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"/></svg>
    </a>
  </ul>
</section>

</main>


<!-- TypeIt Script -->
<script>
  import TypeIt from "typeit";

  const roleEl = document.getElementById("hero-title-role");
  const nameEl = document.getElementById("hero-title-name");
  const descEl = document.getElementById("hero-description");

  if (roleEl && nameEl && descEl) {
    roleEl.innerText = "";
    nameEl.innerText = "";
    descEl.innerText = "";

    new TypeIt(roleEl, {
      strings: ["Full Stack Developer"],
      speed: 70,
      waitUntilVisible: true,
      cursor: true,
      afterComplete: (instance: any) => {
        instance.destroy();
        new TypeIt(nameEl, {
          strings: ["Andrés Retamoso"],
          speed: 70,
          cursor: true,
          afterComplete: (instance: any) => {
            instance.destroy();
            new TypeIt(descEl, {
                strings: ["📍 Barranquilla, Colombia. 🇨🇴"],
                speed: 70,
                cursor: true,
            }).go();
          }
        }).go();
      }
    }).go();
  }
</script>



