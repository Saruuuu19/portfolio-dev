---
import EXPERIENCE from '@/data/experience.json';
---

<section id="experience" class="w-full max-w-4xl px-4 mt-30">

  <div class="mb-5">
      <h2 class="flex items-center gap-2 font-pixel font-bold text-3xl">
        <svg class="size-8" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path><path d="M12 12l0 .01"></path><path d="M3 13a20 20 0 0 0 18 0"></path>
        </svg>
        Experiencia
      </h2>
      <div class="mt-2 h-0.5 w-20 bg-linear-to-r from-accent/70 to-transparent"></div>
  </div>

  <ol class="relative border-s-2 border-accent/30 ms-3 mt-10 space-y-10">
    {
      EXPERIENCE.map((item) => (
        <li class="ms-6 anim-fade-in relative">
          <span class="absolute -left-7.75 top-1.5 size-3 rounded-full bg-accent ring-4 ring-(--bg)"></span>
          <div class="grid grid-cols-1 md:grid-cols-5 md:gap-10 gap-2 items-start">
            <div class="md:col-span-2 flex flex-col">
              <h3 class="text-xl font-bold text-accent">{item.title}</h3>
              <span class="text-sm text-text-soft font-mono mt-1">{item.date}</span>
            </div>
            <div class="md:col-span-3 text-text-soft leading-relaxed">
              {item.description}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>